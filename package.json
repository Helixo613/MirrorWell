{
  "name": "mirrorwell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "seed:dev": "node --experimental-strip-types scripts/seed-dev.ts",
    "inspect-db": "node --experimental-strip-types scripts/inspect-db.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc -b",
    "postinstall": "node --experimental-strip-types scripts/copy-wasm.ts && node --experimental-strip-types scripts/verify-model.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "lucide-react": "0.525.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "recharts": "2.15.4",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
