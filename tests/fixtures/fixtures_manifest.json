{
  "$schemaNote": "docs/MODEL_AND_DATA.md §4 + §7 V1 protocol. Paths per fixture + condition labels + consented self-reported demographics. NEVER names.",
  "$naming": {
    "protocolMasters": "fixture_<subjectId>_<condition>_<trial>.{mp4,webm}",
    "protocolReplay": "fixture_<subjectId>_<condition>_<trial>.mjpeg",
    "conditions": [
      "neutral",
      "smile",
      "yaw_left",
      "yaw_right",
      "low_light",
      "distance_2m"
    ],
    "trials": [1, 2],
    "example": "fixture_S01_yaw_left_1.mp4",
    "notes": [
      "V1 kill-gate (MODEL_AND_DATA §7) requires 2 independent trials × 6 phases per subject.",
      "Yaw phases must be labeled yaw_left / yaw_right; validity uses measured mean |yaw| ∈ [7°,13°] from headPose — operator label alone is not evidence.",
      "Legacy masters without a trial suffix, or with EX_SMILE / yaw_15 condition names, are insufficient for the current protocol and must not be treated as PASS evidence."
    ]
  },
  "$exampleEntryShape": {
    "subjectId": "string, e.g. S01 — never a real name",
    "condition": "neutral | smile | yaw_left | yaw_right | low_light | distance_2m",
    "trial": "1 | 2",
