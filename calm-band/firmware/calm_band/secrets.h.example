// Copy to secrets.h (git-ignored) and fill in. Never commit real credentials.
#pragma once

// Wi-Fi. In Wokwi use "Wokwi-GUEST" with an empty password. For demos, a phone hotspot is safest
// (campus Wi-Fi often needs a browser login page the ESP32 cannot complete).
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASS ""

// MQTT broker. For EMQX Cloud Serverless: host from the deployment overview, port 8883, TLS on,
// a per-device username/password, and the CA certificate EMQX gives you.
#define MQTT_HOST "your-deployment.emqxsl.com"
#define MQTT_PORT 8883
#define MQTT_USE_TLS 1
#define MQTT_USER "cb-01"
#define MQTT_PASS "change-me"
#define DEVICE_ID "cb-01"

// PEM of the broker's CA certificate (only used when MQTT_USE_TLS is 1).
static const char MQTT_CA_CERT[] = R"PEM(
-----BEGIN CERTIFICATE-----
...paste the CA certificate from your broker here...
-----END CERTIFICATE-----
)PEM";
